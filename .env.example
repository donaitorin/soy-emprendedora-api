# Postgres connection string, async driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/soy_emprendedora

# Own API JWT (never confuse with Meta's access_token)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MINUTES=1440

# Fernet key used to encrypt Meta access tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Meta / Facebook Developers app credentials
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/meta/callback
META_OAUTH_SCOPES=pages_show_list,instagram_basic,instagram_manage_insights,business_management

# External frontend origin, used for CORS
FRONTEND_URL=http://localhost:3000

# Object storage for lead PDFs (S3-compatible, private bucket). Cloudflare R2 today;
# to move to AWS S3 change these values and leave CLOUDFLARE_BUCKET_ENDPOINT empty.
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS=
# Account endpoint WITHOUT the bucket name, e.g. https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_ENDPOINT=
CLOUDFLARE_BUCKET_NAME=
